{
  "name": "concorde",
  "version": "1.2.0",
  "description": "Concorde - chat de voz, vídeo e texto portátil estilo Discord (Electron + React + WebRTC)",
  "author": "Concorde",
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env ELECTRON_DEV=1 electron .\"",
    "build:web": "vite build",
    "start": "npm run build:web && electron .",
    "dist": "npm run build:web && electron-builder --win portable",
    "dist:dir": "npm run build:web && electron-builder --win portable --dir"
  },
  "dependencies": {
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "rcedit": "^3.0.1",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.concorde.app",
    "productName": "Concorde",
    "files": [
      "electron/**/*",
      "!electron/native/**",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/native/bin/concorde-audio.exe",
        "to": "concorde-audio.exe"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "afterPack": "build/afterPack.js",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "Concorde-${version}-portable.${ext}"
    },
    "portable": {
      "artifactName": "Concorde-${version}-portable.${ext}"
    }
  }
}
