# Variáveis de ambiente do servidor Concorde (exemplo).
# Copie para ".env" só se for rodar localmente com um carregador de .env;
# no Render, defina estas variáveis no painel (Environment).

# Porta em que o servidor escuta. O código usa process.env.PORT || 3001.
# No Render isso é definido automaticamente — você NÃO precisa configurar lá.
PORT=3001
